<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Wymuś HTTPS (obsługa proxy/SSL home.pl)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Jedna wersja adresu: bez www
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # ——— Stare adresy z WordPressa (/pl/*) ————————————————————————————
  # Do 09.2026 SPA odpowiadała na nie stroną główną z kodem 200 (miękkie 404).
  # Google trzymał je w indeksie ze starymi tytułami: /pl/kontakt miało
  # 127 wyświetleń na pozycji 3,65, a /pl/montaz rankowało na frazę
  # „montaż klimatyzacji Racibórz" (277 wyświetleń) — prowadząc donikąd.
  RewriteRule ^pl/?$                    /                                      [L,R=301]
  RewriteRule ^pl/oferta/?$             /klimatyzacja-raciborz                 [L,R=301]
  RewriteRule ^pl/montaz/?$             /montaz-klimatyzacji-raciborz          [L,R=301]
  RewriteRule ^pl/serwis/?$             /serwis-klimatyzacji-raciborz          [L,R=301]
  RewriteRule ^pl/klimatyzacja/?$       /klimatyzacja-raciborz                 [L,R=301]
  RewriteRule ^pl/chlodnictwo/?$        /chlodnictwo-przemyslowe-raciborz      [L,R=301]
  RewriteRule ^pl/pompy-ciepla/?$       /pompy-ciepla-raciborz                 [L,R=301]
  RewriteRule ^pl/wentylacja/?$         /wentylacja-raciborz                   [L,R=301]
  RewriteRule ^pl/wypozyczalnia/?$      /wypozyczalnia-klimatyzatorow-raciborz [L,R=301]
  RewriteRule ^pl/realizacje/?$         /realizacje                            [L,R=301]
  # Reszta /pl/* (kontakt, salon, cokolwiek jeszcze siedzi w indeksie) na stronę główną
  RewriteRule ^pl/.*$                   /                                      [L,R=301]

  # ——— Serwowanie ——————————————————————————————————————————————————
  RewriteRule ^index\.html$ - [L]

  # Trasa z własnym prerenderem: /montaz-klimatyzacji-raciborz -> montaz-klimatyzacji-raciborz.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+?)/?$ /$1.html [L]

  # Wszystko pozostałe: czysta powłoka SPA z noindex.
  # Wcześniej fallback szedł na index.html, więc każdy literówkowy adres
  # był duplikatem strony głównej z canonicalem „/" i „index, follow".
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /powloka.html [L]
</IfModule>

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Cache Control - assets have hash in filename, safe to cache long
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  # Hashed assets - immutable cache
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Images
  <FilesMatch "\.(webp|png|jpg|jpeg|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # HTML - no cache
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>

<FilesMatch "(\.env|\.git|composer\.(json|lock)|package(-lock)?\.json)$">
  Order allow,deny
  Deny from all
</FilesMatch>

ServerSignature Off
